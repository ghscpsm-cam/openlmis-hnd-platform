# TEST MSPAS/SESAL Honduras (des-lmis-all.salud.gob.hn, http, 16GB/4CPU): copiar a env/test.env.
# Durante la instalación un comando pone la IP del servidor en OPENLMIS_HOST_IP.
ENVIRONMENT=test

# Deployment ref-distro (OPENLMIS_URL es el health-check local; la URL pública va en settings.env)
REFDISTRO_DIR=/opt/openlmis-ref-distro
DB_CONTAINER=openlmis-ref-distro-db-1
DB_NAME=open_lmis
DB_USER=postgres
OPENLMIS_URL=http://localhost

# Configuración regional usada por el override de la UI.
LOCALE=es
COUNTRY=HN
CURRENCY_CODE=HNL
CURRENCY_SYMBOL=L
CURRENCY_LOCALE=HN
TIME_ZONE=America/Tegucigalpa

# DNS interno MSPAS: si el servidor no resuelve su propio dominio, Docker lo agrega al /etc/hosts
# de cada servicio (ver overrides/openlmis-ref-distro.yml).
OPENLMIS_HOST_ALIAS=des-lmis-all.salud.gob.hn
OPENLMIS_HOST_IP=IP_PENDIENTE

# Stockmanagement con reportes en español, construida en el servidor:
#   docker build -t openlmis-hnd-stockmanagement:5.3.0-hnd.1 images/stockmanagement
STOCKMANAGEMENT_IMAGE=openlmis-hnd-stockmanagement:5.3.0-hnd.1

# Nginx: tamaño máximo para PUT/POST grandes, por ejemplo requisiciones extensas.
CLIENT_MAX_BODY_SIZE=50m

# Recursos para servidor de 16GB / 4 CPUs.
REFERENCEDATA_MEM_LIMIT=5G
REFERENCEDATA_XMX=4096m
REFERENCEDATA_CPUS=4
REPORT_MEM_LIMIT=2G
REPORT_XMX=1536m
REPORT_CPUS=2
STOCKMANAGEMENT_MEM_LIMIT=2G
STOCKMANAGEMENT_XMX=1536m
STOCKMANAGEMENT_CPUS=2

# Capa 2 — seeder
SEEDER_DIR=/opt/openlmis-seeder
# Cambiar a honduras-base cuando ese set se publique en openlmis-seeder.
SEED_SET=minimal
SEED_USERNAME=REEMPLAZAR_USUARIO
SEED_PASSWORD=REEMPLAZAR_CONTRASENA

# Base limpia para `platform reset test --confirm` (datos maestros, sin transacciones ni usuarios de prueba)
BASELINE_FILE=baselines/test_baseline.dump
